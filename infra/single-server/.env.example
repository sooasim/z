# JETPOOL single-server configuration. Copy to infra/single-server/.env — or better, let
# `./infra/single-server/jetpool.sh init` write it, which fills every AUTO_GENERATE slot with real
# randomness. The real .env is gitignored and must never be committed.
#
# Changing PUBLIC_*/NEXT_PUBLIC_API_URL means rebuilding the web image (the URL is inlined into the
# browser bundle and into the CSP), so run `jetpool.sh deploy` after any edit here, not just `up`.

# ---------------------------------------------------------------- mode and public addresses
# domain = Caddy + Let's Encrypt on 80/443 (what you want in the end)
# ip     = plain HTTP on the public IP, for the first smoke test only
DEPLOY_MODE=domain
CADDYFILE=Caddyfile

ROOT_DOMAIN=example.com
# Where Let's Encrypt sends expiry warnings. Required in domain mode.
ACME_EMAIL=you@example.com

# Extra domains that also point at this server. They get their own certificates and 301-redirect to
# ROOT_DOMAIN, so one address keeps the sessions, cookies, OAuth callbacks and search results.
# Managed with `jetpool.sh domain add <name>` / `domain remove <name>` — do not hand-edit while the
# stack is running, or alt-domains.caddy and this line drift apart.
ALT_DOMAINS=

PUBLIC_WEB_URL=https://example.com
PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://example.com,https://www.example.com
# ---------------------------------------------------------------- media storage
# local  = media on the `mediadata` docker volume, uploaded to and served by the API. No object-storage
#          service, no third-party image. This is the default and what a single server wants.
# minio  = run MinIO (compose profile "minio") and talk S3 to it. Needs an image you can actually pull:
#          MinIO withdrew minio/minio and minio/mc from Docker Hub, and quay.io answered 401 for
#          `latest`, so confirm MINIO_IMAGE / MINIO_MC_IMAGE with `docker pull` before switching.
# `jetpool.sh init --storage <mode>` writes this and the four values below to match.
STORAGE_MODE=local

# Blank in local mode — blank S3_* is exactly what makes the API choose its disk-backed adapter.
# S3_ENDPOINT also becomes NEXT_PUBLIC_MEDIA_ORIGIN in the web build, because the browser uploads
# straight to that origin and the page's own CSP has to allow it.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where public media is served from. local: https://api.<domain>/media-dev
CDN_BASE_URL=https://api.example.com/media-dev

# Loopback-only in domain mode; `init --ip` sets both to 0.0.0.0.
API_BIND=127.0.0.1
MINIO_BIND=127.0.0.1

# ---------------------------------------------------------------- runtime
# staging keeps the MOCK payment provider and mock OAuth usable, and lets the demo seed run.
# Switch to production ONLY with real Toss keys and real OAuth clients (see the runbook) — the API
# refuses to boot in production with PAYMENT_PROVIDER=MOCK or OAUTH_MOCK=true.
NODE_ENV=staging
LOG_LEVEL=info
DATABASE_POOL_MAX=10
RATE_LIMIT_PER_MIN=600
IMAGE_TAG=local

# ---------------------------------------------------------------- secrets (generated by `jetpool.sh init`)
# Rotating JWT_SECRET signs every session out. Rotating DATA_ENCRYPTION_KEY or GEO_FUZZ_SECRET makes
# already-encrypted data (MFA secrets) and existing coordinate offsets unreadable. Generate once, back up.
POSTGRES_PASSWORD=AUTO_GENERATE
JWT_SECRET=AUTO_GENERATE
DATA_ENCRYPTION_KEY=AUTO_GENERATE
GEO_FUZZ_SECRET=AUTO_GENERATE
MEILI_MASTER_KEY=AUTO_GENERATE
MINIO_ROOT_USER=jetpool
MINIO_ROOT_PASSWORD=AUTO_GENERATE
# Where the MinIO images come from. MinIO withdrew minio/minio and minio/mc from Docker Hub, so these
# default to quay.io. If a pull fails with "repository does not exist or may require 'docker login'",
# the image moved again — set these two and re-run deploy, no code change needed.
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:latest

# Demo-seed logins (`jetpool.sh seed`). Generated too — the repo defaults are below the API's own
# password policy and exist only because the seed writes the hash directly.
SEED_PASSWORD=AUTO_GENERATE
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=AUTO_GENERATE

# ---------------------------------------------------------------- admin console second factor
# true  = staff routes need an AAL2 (authenticator) session — the shipped behaviour, CORE-01.
# false = the staff password is the whole gate, for a demo console where nobody can enroll an app.
#         Anyone who learns the admin password is then inside; keep SSH narrow, use a long password,
#         and turn it back on before real customer data lands. The API refuses it in production.
# `jetpool.sh admin-mfa off|on` flips this and restarts the API.
STAFF_MFA_REQUIRED=true

# ---------------------------------------------------------------- payments (PAY-01)
# MOCK until the Toss merchant contract is live. MOCK is forbidden in NODE_ENV=production.
PAYMENT_PROVIDER=MOCK
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
TOSS_WEBHOOK_SECRET=

# ---------------------------------------------------------------- sign-in providers
# true = the mock adapter (anyone can "log in" as a provider user). Forbidden in production.
OAUTH_MOCK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------------------------------------------------------------- optional services
# Without SMTP_URL, e-mail verification codes are only written to the API log. In production the API
# rejects code delivery outright when no provider is configured.
SMTP_URL=
# AI assistant (flag ai.assistant, default OFF) and model-side content translation.
ANTHROPIC_API_KEY=
# STATIC needs no key. KAKAO geocoding needs KAKAO_REST_API_KEY.
GEOCODER=STATIC
KAKAO_REST_API_KEY=
