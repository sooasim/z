# JETPOOL single-server configuration. Copy to infra/single-server/.env — or better, let
# `./infra/single-server/jetpool.sh init` write it, which fills every AUTO_GENERATE slot with real
# randomness. The real .env is gitignored and must never be committed.
#
# Changing PUBLIC_*/NEXT_PUBLIC_API_URL means rebuilding the web image (the URL is inlined into the
# browser bundle and into the CSP), so run `jetpool.sh deploy` after any edit here, not just `up`.

# ---------------------------------------------------------------- mode and public addresses
# domain = Caddy + Let's Encrypt on 80/443 (what you want in the end)
# ip     = plain HTTP on the public IP, for the first smoke test only
DEPLOY_MODE=domain
CADDYFILE=Caddyfile

ROOT_DOMAIN=example.com
# Where Let's Encrypt sends expiry warnings. Required in domain mode.
ACME_EMAIL=you@example.com

PUBLIC_WEB_URL=https://example.com
PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://example.com,https://www.example.com
# Also becomes NEXT_PUBLIC_MEDIA_ORIGIN in the web build: the browser uploads here directly, so the
# origin must be allowed by the page's own CSP.
S3_ENDPOINT=https://s3.example.com
CDN_BASE_URL=https://s3.example.com/jetpool-public

# Loopback-only in domain mode; `init --ip` sets both to 0.0.0.0.
API_BIND=127.0.0.1
MINIO_BIND=127.0.0.1

# ---------------------------------------------------------------- runtime
# staging keeps the MOCK payment provider and mock OAuth usable, and lets the demo seed run.
# Switch to production ONLY with real Toss keys and real OAuth clients (see the runbook) — the API
# refuses to boot in production with PAYMENT_PROVIDER=MOCK or OAUTH_MOCK=true.
NODE_ENV=staging
LOG_LEVEL=info
DATABASE_POOL_MAX=10
RATE_LIMIT_PER_MIN=600
IMAGE_TAG=local

# ---------------------------------------------------------------- secrets (generated by `jetpool.sh init`)
# Rotating JWT_SECRET signs every session out. Rotating DATA_ENCRYPTION_KEY or GEO_FUZZ_SECRET makes
# already-encrypted data (MFA secrets) and existing coordinate offsets unreadable. Generate once, back up.
POSTGRES_PASSWORD=AUTO_GENERATE
JWT_SECRET=AUTO_GENERATE
DATA_ENCRYPTION_KEY=AUTO_GENERATE
GEO_FUZZ_SECRET=AUTO_GENERATE
MEILI_MASTER_KEY=AUTO_GENERATE
MINIO_ROOT_USER=jetpool
MINIO_ROOT_PASSWORD=AUTO_GENERATE

# Demo-seed logins (`jetpool.sh seed`). Generated too — the repo defaults are below the API's own
# password policy and exist only because the seed writes the hash directly.
SEED_PASSWORD=AUTO_GENERATE
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=AUTO_GENERATE

# ---------------------------------------------------------------- payments (PAY-01)
# MOCK until the Toss merchant contract is live. MOCK is forbidden in NODE_ENV=production.
PAYMENT_PROVIDER=MOCK
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
TOSS_WEBHOOK_SECRET=

# ---------------------------------------------------------------- sign-in providers
# true = the mock adapter (anyone can "log in" as a provider user). Forbidden in production.
OAUTH_MOCK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------------------------------------------------------------- optional services
# Without SMTP_URL, e-mail verification codes are only written to the API log. In production the API
# rejects code delivery outright when no provider is configured.
SMTP_URL=
# AI assistant (flag ai.assistant, default OFF) and model-side content translation.
ANTHROPIC_API_KEY=
# STATIC needs no key. KAKAO geocoding needs KAKAO_REST_API_KEY.
GEOCODER=STATIC
KAKAO_REST_API_KEY=
