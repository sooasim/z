environment              = "staging"
node_env                 = "staging"
payment_provider         = "TOSS" # Toss *test* keys in the staging secret
vpc_cidr                 = "10.40.0.0/16"
az_count                 = 2
single_nat_gateway       = true
web_domain               = "staging.jetpool.kr"
api_domain               = "api.staging.jetpool.kr"
media_domain             = "media.staging.jetpool.kr"
route53_zone_id          = "ZREPLACE_ME_STAGING"
db_instance_class        = "db.t4g.medium"
db_multi_az              = false
db_backup_retention_days = 14
redis_node_type          = "cache.t4g.small"
redis_replicas           = 0
api_desired              = 1
api_max                  = 3
web_desired              = 1
web_max                  = 3
worker_desired           = 1
log_retention_days       = 30
deletion_protection      = false
waf_rate_limit_per_5min  = 3000
waf_bot_control_block    = false
alert_emails             = ["oncall-staging@jetpool.kr"]
github_repository        = "jetpool/jetpool"
github_environment       = "staging"
# set true in exactly one env per AWS account
create_github_oidc_provider = true
