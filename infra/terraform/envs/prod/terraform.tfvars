environment              = "prod"
node_env                 = "production"
payment_provider         = "TOSS"
vpc_cidr                 = "10.50.0.0/16"
az_count                 = 3
single_nat_gateway       = false
web_domain               = "jetpool.kr"
api_domain               = "api.jetpool.kr"
media_domain             = "media.jetpool.kr"
route53_zone_id          = "ZREPLACE_ME_PROD"
db_instance_class        = "db.r7g.large"
db_multi_az              = true
db_backup_retention_days = 35
redis_node_type          = "cache.r7g.large"
redis_replicas           = 1
api_desired              = 3
api_max                  = 12
web_desired              = 2
web_max                  = 8
worker_desired           = 2
log_retention_days       = 365
deletion_protection      = true
waf_rate_limit_per_5min  = 2000
waf_bot_control_block    = true
alert_emails             = ["oncall@jetpool.kr"]
github_repository        = "jetpool/jetpool"
github_environment       = "production"
# prod lives in a separate AWS account -> it creates its own OIDC provider
create_github_oidc_provider = true
