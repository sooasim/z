{
  "name": "jetpool",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @jetpool/db migrate",
    "db:seed": "pnpm --filter @jetpool/db seed",
    "dev:api": "pnpm --filter @jetpool/api dev",
    "dev:web": "pnpm --filter @jetpool/web dev",
    "contracts:generate": "pnpm --filter @jetpool/api contracts:export",
    "validate:spec": "node scripts/validate-spec.mjs",
    "release:report": "node scripts/release-report.mjs"
  }
}
