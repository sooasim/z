# Public API origin (Fastify, apps/api)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side API origin used by the BFF auth proxy / middleware (defaults to NEXT_PUBLIC_API_URL)
API_INTERNAL_URL=
# Canonical web origin for sitemap/robots/OAuth redirect URIs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
